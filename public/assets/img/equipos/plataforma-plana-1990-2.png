<svg width="300" height="200" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="300" height="200" fill="#f8f9fa"/>
  
  <!-- Ground line -->
  <line x1="0" y1="160" x2="300" y2="160" stroke="#666" stroke-width="2"/>
  
  <!-- Trailer platform -->
  <rect x="50" y="120" width="200" height="15" fill="#2563eb" stroke="#1d4ed8" stroke-width="2"/>
  
  <!-- Platform details -->
  <rect x="55" y="125" width="190" height="5" fill="#3b82f6"/>
  
  <!-- Axles -->
  <rect x="80" y="135" width="8" height="25" fill="#1e40af"/>
  <rect x="210" y="135" width="8" height="25" fill="#1e40af"/>
  
  <!-- Wheels -->
  <circle cx="84" cy="150" r="10" fill="#1a202c" stroke="#4a5568" stroke-width="2"/>
  <circle cx="84" cy="150" r="6" fill="#718096"/>
  <circle cx="214" cy="150" r="10" fill="#1a202c" stroke="#4a5568" stroke-width="2"/>
  <circle cx="214" cy="150" r="6" fill="#718096"/>
  
  <!-- Landing gear -->
  <rect x="60" y="135" width="4" height="15" fill="#1e40af"/>
  <rect x="235" y="135" width="4" height="15" fill="#1e40af"/>
  
  <!-- Kingpin area -->
  <rect x="45" y="115" width="15" height="10" fill="#1e40af"/>
  
  <!-- Side rails -->
  <rect x="50" y="118" width="200" height="2" fill="#1e40af"/>
  <rect x="50" y="135" width="200" height="2" fill="#1e40af"/>
  
  <!-- Distinctive markings -->
  <rect x="70" y="122" width="160" height="1" fill="#fbbf24" stroke="#f59e0b" stroke-width="0.5"/>
  <rect x="70" y="130" width="160" height="1" fill="#fbbf24" stroke="#f59e0b" stroke-width="0.5"/>
  
  <!-- Text -->
  <text x="150" y="50" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#1e40af">PLATAFORMA PLANA 1990</text>
  <text x="150" y="70" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#2563eb">VIN: 19203134</text>
  <text x="150" y="85" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#3b82f6">40,000-50,000 lbs</text>
</svg>