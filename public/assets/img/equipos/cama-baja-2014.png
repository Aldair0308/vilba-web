<svg width="400" height="200" viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="400" height="200" fill="#f8f9fa"/>
  
  <!-- Ground line -->
  <line x1="0" y1="180" x2="400" y2="180" stroke="#666" stroke-width="2"/>
  
  <!-- Main trailer deck -->
  <rect x="80" y="140" width="280" height="15" fill="#8B4513" stroke="#654321" stroke-width="2"/>
  
  <!-- Gooseneck -->
  <rect x="40" y="120" width="60" height="8" fill="#4169E1" stroke="#1E3A8A" stroke-width="2"/>
  
  <!-- Gooseneck connection -->
  <circle cx="40" cy="124" r="6" fill="#FF6B35" stroke="#CC5429" stroke-width="2"/>
  
  <!-- Front ramps -->
  <polygon points="80,140 60,160 80,155" fill="#8B4513" stroke="#654321" stroke-width="1"/>
  
  <!-- Axles (3-axle tandem) -->
  <rect x="280" y="155" width="8" height="25" fill="#2C3E50"/>
  <rect x="300" y="155" width="8" height="25" fill="#2C3E50"/>
  <rect x="320" y="155" width="8" height="25" fill="#2C3E50"/>
  
  <!-- Wheels -->
  <circle cx="284" cy="170" r="12" fill="#1A1A1A" stroke="#333" stroke-width="2"/>
  <circle cx="284" cy="170" r="8" fill="#666"/>
  <circle cx="304" cy="170" r="12" fill="#1A1A1A" stroke="#333" stroke-width="2"/>
  <circle cx="304" cy="170" r="8" fill="#666"/>
  <circle cx="324" cy="170" r="12" fill="#1A1A1A" stroke="#333" stroke-width="2"/>
  <circle cx="324" cy="170" r="8" fill="#666"/>
  
  <!-- Side rails -->
  <rect x="80" y="135" width="280" height="3" fill="#4169E1"/>
  <rect x="80" y="157" width="280" height="3" fill="#4169E1"/>
  
  <!-- Support beams -->
  <rect x="120" y="140" width="3" height="15" fill="#4169E1"/>
  <rect x="160" y="140" width="3" height="15" fill="#4169E1"/>
  <rect x="200" y="140" width="3" height="15" fill="#4169E1"/>
  <rect x="240" y="140" width="3" height="15" fill="#4169E1"/>
  
  <!-- Air suspension indicators -->
  <rect x="275" y="150" width="18" height="5" fill="#FF6B35" rx="2"/>
  <rect x="295" y="150" width="18" height="5" fill="#FF6B35" rx="2"/>
  <rect x="315" y="150" width="18" height="5" fill="#FF6B35" rx="2"/>
  
  <!-- Text labels -->
  <text x="200" y="30" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#2C3E50">LOWBOY TRAILER 2014</text>
  <text x="200" y="50" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#666">VIN: 2M512146471114308</text>
  <text x="200" y="70" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#666">40-55 Tons Capacity</text>
  
  <!-- Capacity indicator -->
  <rect x="10" y="90" width="80" height="30" fill="#E74C3C" rx="5"/>
  <text x="50" y="105" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" font-weight="bold" fill="white">HEAVY</text>
  <text x="50" y="115" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" font-weight="bold" fill="white">DUTY</text>
</svg>