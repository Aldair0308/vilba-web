# Server Configuration
PORT=3000
NODE_ENV=production

# MongoDB Configuration
# Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://vilba_admin:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/vilba?retryWrites=true&w=majority

# JWT Configuration (if applicable)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# CORS Configuration
# Replace with your Laravel app URL after deployment
CORS_ORIGIN=https://your-laravel-app.koyeb.app

# API Configuration
API_PREFIX=api
API_VERSION=v1

# Logging
LOG_LEVEL=info

# Other configurations as needed by your application
